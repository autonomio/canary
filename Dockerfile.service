FROM node:22-bookworm-slim AS codex
ARG CODEX_VERSION=0.162.0
RUN npm install --global @openai/codex@${CODEX_VERSION}

FROM python:3.12-slim-bookworm
COPY --from=ghcr.io/astral-sh/uv:0.9.13 /uv /bin/uv
COPY --from=codex /usr/local/bin/node /usr/local/bin/node
COPY --from=codex /usr/local/lib/node_modules/@openai /usr/local/lib/node_modules/@openai
ENV LANG=C.UTF-8 PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    CANARY_DATA_DIR=/data CODEX_HOME=/auth
RUN apt-get update \
    && apt-get install -y --no-install-recommends git curl ripgrep poppler-utils \
    && ln -s /usr/local/lib/node_modules/@openai/codex/bin/codex.js /usr/local/bin/codex \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY pyproject.toml uv.lock ./
RUN uv export --frozen --no-dev --no-emit-project -o /tmp/runtime.txt \
    && uv pip install --system --require-hashes -r /tmp/runtime.txt
COPY src ./src
COPY scripts/dashboard ./scripts/dashboard
COPY scripts/coverage_run.sh ./scripts/coverage_run.sh
RUN uv build --wheel --out-dir /tmp/wheels \
    && uv pip install --system --no-deps /tmp/wheels/*.whl \
    && rm -rf /build /tmp/wheels /tmp/runtime.txt \
    && useradd --create-home --uid 10001 canary \
    && mkdir -p /data /auth && chown canary:canary /data /auth
USER canary
WORKDIR /data
VOLUME ["/data", "/auth"]
EXPOSE 8789
ENTRYPOINT ["canary"]
CMD ["runs", "serve", "--host", "0.0.0.0"]
